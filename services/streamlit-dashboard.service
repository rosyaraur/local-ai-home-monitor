[Unit]
Description=Streamlit Server Command Center
After=network.target

[Service]
User=<YOUR_USER>
WorkingDirectory=/home/<YOUR_USER>/server-dashboard
ExecStart=/home/<YOUR_USER>/.local/bin/streamlit run dashboard.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
